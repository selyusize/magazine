# Имя compose-проекта (префикс контейнеров и volume)
COMPOSE_PROJECT_NAME=magazine

# --- PostgreSQL
POSTGRES_USER=medusa
POSTGRES_PASSWORD=medusa
POSTGRES_DB=medusa
POSTGRES_PORT=5432

# --- Redis
REDIS_PORT=6379

# --- Medusa (backend)
# В проде обязательно заменить: openssl rand -base64 32 / openssl rand -hex 32
JWT_SECRET=supersecret
JWT_EXPIRES_IN=7d
COOKIE_SECRET=supersecret
AUTH_MFA_ENCRYPTION_KEY=
# Публичные адреса, с которых браузер ходит в API
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000
BACKEND_PORT=9000

# --- Frontend
FRONTEND_PORT=3000
# Адрес Medusa для браузера (вшивается в бандл при сборке образа)
NEXT_PUBLIC_API_URL=http://localhost:9000
# Publishable API key: админка Medusa → Settings → Publishable API Keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
