# Управляется Ansible (roles/frontend)
# SSR и Server Components ходят в Medusa по внутренней docker-сети, браузер — по NEXT_PUBLIC_API_URL из образа
API_INTERNAL_URL='{{ frontend_api_internal_url }}'
# Вебхук ревалидации POST /api/revalidate: тот же секрет, что у магазина в Medusa («Обновление витрины»)
REVALIDATE_SECRET='{{ vault_storefront_revalidate_secret | default('') }}'
{% for key, value in frontend_env.items() %}
{{ key }}='{{ value }}'
{% endfor %}
