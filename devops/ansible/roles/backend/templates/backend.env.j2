# Управляется Ansible (roles/backend)
NODE_ENV='production'
DATABASE_URL='postgres://{{ postgres_user }}:{{ postgres_password }}@{{ postgres_host }}:5432/{{ postgres_db }}?sslmode=disable'
REDIS_URL='redis://:{{ redis_password }}@{{ redis_host }}:6379'

JWT_SECRET='{{ backend_jwt_secret }}'
JWT_EXPIRES_IN='{{ backend_jwt_expires_in }}'
COOKIE_SECRET='{{ backend_cookie_secret }}'
AUTH_MFA_ENCRYPTION_KEY='{{ backend_auth_mfa_encryption_key }}'
SHOP_SECRETS_KEY='{{ backend_shop_secrets_key }}'
INITIAL_SHOP_REVALIDATE_SECRET='{{ backend_initial_shop_revalidate_secret }}'

STORE_CORS='{{ backend_store_cors }}'
ADMIN_CORS='{{ backend_admin_cors }}'
AUTH_CORS='{{ backend_auth_cors }}'
MEDUSA_FILE_URL='https://{{ backend_domain }}/static'

# Почта и ссылки в письмах
SHOP_NAME='{{ shop_name }}'
STOREFRONT_URL='https://{{ frontend_domain }}'
MEDUSA_ADMIN_URL='https://{{ backend_domain }}'
{% if smtp_host %}
SMTP_HOST='{{ smtp_host }}'
SMTP_PORT='{{ smtp_port }}'
SMTP_SECURE='{{ smtp_secure | bool | lower }}'
SMTP_USER='{{ smtp_user }}'
SMTP_PASSWORD='{{ vault_smtp_password | default('') }}'
SMTP_FROM='{{ smtp_from }}'
{% endif %}
{% if cdek_client_id %}

# Доставка СДЭК
CDEK_BASE_URL='{{ cdek_base_url }}'
CDEK_CLIENT_ID='{{ cdek_client_id }}'
CDEK_CLIENT_SECRET='{{ vault_cdek_client_secret | default('') }}'
{% endif %}
{% if vault_yandex_delivery_token | default('') %}

# Яндекс Доставка
YANDEX_DELIVERY_BASE_URL='{{ yandex_delivery_base_url }}'
YANDEX_DELIVERY_TOKEN='{{ vault_yandex_delivery_token }}'
{% endif %}
{% if rabbitmq_enabled %}

RABBITMQ_URL='amqp://{{ rabbitmq_user }}:{{ rabbitmq_password }}@{{ rabbitmq_host }}:5672/{{ rabbitmq_vhost | urlencode }}'
{% endif %}
{% set extra_env = backend_env | combine(vault_backend_env | default({})) %}
{% if extra_env %}

# backend_env + vault_backend_env
{% for key, value in extra_env.items() %}
{{ key }}='{{ value }}'
{% endfor %}
{% endif %}
