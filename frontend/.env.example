# Адрес Medusa для браузера
NEXT_PUBLIC_API_URL=http://localhost:9000
# Адрес Medusa для сервера Next (в Docker — http://backend:9000). По умолчанию = NEXT_PUBLIC_API_URL
# API_INTERNAL_URL=http://localhost:9000
# Publishable API key: админка Medusa → Settings → Publishable API Keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
# Внешние хосты фото товаров для next/image (S3, CDN) через пробел. Демо-данные Medusa:
# IMAGE_REMOTE_HOSTS=medusa-public-images.s3.eu-west-1.amazonaws.com
# Регион Medusa для цен в каталоге и поиске (reg_…). По умолчанию — первый регион магазина
# MEDUSA_REGION_ID=
# Секрет вебхука ревалидации POST /api/revalidate — админка Medusa → «Обновление витрины» (в dev пишет `make dev-key`).
# Пусто — вебхук отклоняется, кэш обновляется только по TTL
REVALIDATE_SECRET=
# Другая OpenAPI-схема для `pnpm api:generate` (по умолчанию ../backend/openapi/store.oas.json)
# OPENAPI_SCHEMA=
