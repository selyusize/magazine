{
  "name": "magazine-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm api:generate && next dev",
    "build": "pnpm api:generate && next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fsd": "steiger ./src",
    "typecheck": "pnpm api:generate && tsc --noEmit",
    "api:generate": "orval --config orval.config.ts",
    "test": "pnpm api:generate && vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "pnpm api:generate && vitest run --project integration"
  },
  "dependencies": {
