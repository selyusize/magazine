{
  "name": "magazine-backend",
  "version": "0.0.1",
  "description": "Medusa backend интернет-магазина",
  "license": "MIT",
  "scripts": {
    "dev": "medusa develop",
    "build": "medusa build",
    "start": "medusa start",
    "lint": "eslint .",
    "db:migrate": "medusa db:migrate",
    "seed": "medusa exec ./src/scripts/seed-demo-products.ts",
    "images:resize": "medusa exec ./src/scripts/resize-images.ts",
    "user:create": "medusa user",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "openapi:generate": "medusa-oas oas --type store --out-dir openapi -p src/api"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.21.2",
    "@medusajs/admin-shared": "2.21.2",
    "@medusajs/caching": "2.21.2",
    "@medusajs/cli": "2.21.2",
    "@medusajs/dashboard": "2.21.2",
    "@medusajs/draft-order": "2.21.2",
    "@medusajs/framework": "2.21.2",
    "@medusajs/icons": "2.21.2",
    "@medusajs/js-sdk": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "@medusajs/ui": "4.2.6",
    "@tanstack/react-query": "5.64.2",
    "nodemailer": "^10.0.13",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "reflect-metadata": "0.2.2",
    "saxes": "^6.0.0",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.21.2",
    "@medusajs/medusa-oas-cli": "2.21.2",
    "@medusajs/test-utils": "2.21.2",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.6",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@11.25.0",
  "private": true
}
