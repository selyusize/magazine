# Локальная разработка: postgres и redis из devops/docker-compose.yml
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa
# С REDIS_URL события, workflows, блокировки и кэш (модуль caching) идут через Redis
REDIS_URL=redis://localhost:6379

# Витрина (Next.js) — store API; админка Medusa живёт на :9000/app
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:5173,http://localhost:9000

# В проде обязательно заменить (openssl rand -base64 32 / openssl rand -hex 32)
JWT_SECRET=supersecret
# Срок жизни JWT (1d, 7d, 30d…). Витрина продлевает токен, когда прошла половина срока
JWT_EXPIRES_IN=7d
COOKIE_SECRET=supersecret
AUTH_MFA_ENCRYPTION_KEY=

MEDUSA_ADMIN_ONBOARDING_TYPE=default

# Время магазина — московское (расписания jobs, логи, даты в письмах)
TZ=Europe/Moscow

# Публичный адрес загрузок (папка backend/static). На проде — https://api.<домен>/static, отдаёт nginx
MEDUSA_FILE_URL=http://localhost:9000/static

# Почта: сервис SMTP (src/shared/smtp), настройки читает src/container/common/smtp.ts.
# Локально — Mailpit (devops/docker-compose.yml), письма смотреть на http://localhost:8025. Пустой SMTP_HOST — только лог
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="Магазин <shop@localhost>"
SHOP_NAME=Магазин
# Ссылки в письмах (сброс пароля, приглашения)
STOREFRONT_URL=http://localhost:3000
MEDUSA_ADMIN_URL=http://localhost:9000

# Доставка (src/modules/fulfillment-*). Перевозчик без ключей не подключается, и сид не создаёт его способы.
# Ниже — публичные тестовые контуры из документации перевозчиков: заказы не исполняются.
# СДЭК: тест https://api.edu.cdek.ru (адреса только по Москве), прод https://api.cdek.ru + ключи договора
CDEK_BASE_URL=https://api.edu.cdek.ru
CDEK_CLIENT_ID=wqGwiQx0gg8mLtiEKsUinjVSICCjtTEP
CDEK_CLIENT_SECRET=RmAmgvSgSl1yirlz9QupbzOJVqhCxcP5
# Тарифы СДЭК: 136 — склад–склад (до ПВЗ), 137 — склад–дверь
CDEK_TARIFF_PICKUP=136
CDEK_TARIFF_DOOR=137
# Яндекс Доставка: тест https://b2b.taxi.tst.yandex.net, прод https://b2b-authproxy.taxi.yandex.net + токен из кабинета
YANDEX_DELIVERY_BASE_URL=https://b2b.taxi.tst.yandex.net
YANDEX_DELIVERY_TOKEN=
# Посылка, если у товара нет веса/габаритов: вес единицы, г; сторона коробки, см
DELIVERY_ITEM_WEIGHT=500
DELIVERY_BOX_SIDE=20
